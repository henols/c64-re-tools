RANGE { START $08B1; END $08B3; TYPE ByteTable; NAME "rts_lo"; };
RANGE { START $08B4; END $08B6; TYPE ByteTable; NAME "rts_hi"; };

# ---- full address table ----
RANGE { START $08B7; END $08BE; TYPE AddrTable; NAME "addrtab"; };

# ---- arrays ----
RANGE { START $08BF; END $08DE; TYPE ByteTable; NAME "arr_src"; };
RANGE { START $08DF; END $08FE; TYPE ByteTable; NAME "arr_dst"; };
RANGE { START $08FF; END $0917; TYPE ByteTable; NAME "objs"; };

