# npm dependencies for the VICE MCP server (src/mcp/vice). Installed by the
# user with `npm ci`; never committed.
node_modules/

# The single tool-written root (D-33, 2026-09-08 clean break; alias added
# 2026-09-08, gap G-40-1): every writer in this codebase that used to
# scatter its output across four separate locations (.vice-supervisor/,
# .vice-snapshots/, tools/*.mjs + vice-launcher.sh + .vice-deployed.json,
# and an incidents directory) now lands
# under ONE directory: supervisor/ (broker state), snapshots/ (.vsf + .json
# sidecars), bin/ (deployed host launcher artifacts), runs/oracle/
# (oracle.run scratch), runs/ghidra/ (ghidra.analyze's run logs and exports,
# as downloaded from the broker), incidents/ (recycle
# incident records), cache/ (the lockfile stamp). A consumer of this package
# gets exactly one ignorable directory and one directory to delete, rather
# than five. This is a clean break: no dual-read of the previous locations,
# no migration shim -- a pre-existing old-layout tree (.vice-supervisor/,
# .vice-snapshots/, tools/*.mjs) is simply left on
# disk, unread, for the user to delete by hand.
/.c64-re-tools/
# ...and the same directory written anywhere else. The rule above is
# root-anchored, so a tool-root resolved from a different cwd (running the
# suite from src/mcp/vice/ deploys one there) landed OUTSIDE it and was
# committable -- twelve generated launcher artifacts, one `git add -A` away
# from the tree. Generated host artifacts are never committed from any depth.
.c64-re-tools/

# A symlink older brokers minted as a Ghidra workaround; nothing creates it
# any more, and it is safe to delete. No trailing slash: git does not treat a
# symlink-to-directory as a directory.
/c64-re-tools

# The npm server build (src/mcp/vice/build.ts --server, run by prepack).
# Built at publish time, never committed.
dist/

# npm pack output
*.tgz

# Local editor config, machine-specific, never shared.
/.vscode/

# .claude/settings.json is now COMMITTED (phase 12, GATE-01): it carries only
# the audit-gate PreToolUse hook wiring (scripts/audit-gate.mjs --hook), no
# machine-specific content. The permission allowlist and additionalDirectories
# that used to live in this file -- absolute worktree paths from earlier
# sessions -- moved to .claude/settings.local.json below, which Claude Code
# merges over the committed file at runtime, so behaviour is unchanged. This
# split honours the original rationale (machine-specific permission content
# must not be committed) rather than overriding it; settings.local.json is
# also covered by many users' global gitignore, but this repo-level rule
# makes the guarantee local and explicit rather than relying on that.
/.claude/settings.local.json

# Local Claude Code tooling (commands, skills, agents, hooks). Machine-local
# and not project source.
/.claude/agents/
/.claude/commands/
/.claude/hooks/
/.claude/scripts/
/.claude/skills/
# .agents/ is skills-manager scratch and stays ignored, EXCEPT the mastra skill,
# which is kept in-repo so git worktrees (tracked files only) can read it.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/mastra/
/.codex/

# Real-release disk images for the opt-in live corpus tests (dxa-live,
# ghidra-live, ghidra-opcode-live). Never committed.
/corpus/

# Graphify raw scratch output. Regenerable, so it is ignored.
/graphify-out/

# Phase 35 (DXA-01): the built dxa binary and its intermediate object files.
# vendor/dxa/build.bash's `build` verb reproduces the binary from the
# committed, pinned source on demand -- it is host-architecture-specific and
# a digest gate already defends the committed pin, so committing the binary
# itself would publish an artifact no digest gate could then re-verify.
/src/mcp/vice/vendor/dxa/dxa
/src/mcp/vice/vendor/dxa/*.o

# Phase 36 (OPC-01): the built SLEIGH language file. `ghidra.installExtension`
# / the sleigh-compile-gate.test.ts COMPILE half reproduce it from the
# committed extension source on demand -- mirrors vendor/dxa/dxa above.
/src/mcp/vice/vendor/ghidra-ext/data/languages/6502_nmos.sla
