# Dependencies, installed with `pnpm install`; never committed.
node_modules/

# Toolkit-owned project state (.c64-re-tools/knowledge.db). An analysed
# project commits it; this repository is the tool, and its test runs write
# one of their own, so here it stays ignored at any depth.
.c64-re-tools/

# npm pack output.
*.tgz

# Local editor config, machine-specific, never shared.
/.vscode/

# .claude/settings.json is committed and holds no machine-specific content.
# Machine-specific permissions go in .claude/settings.local.json.
/.claude/settings.local.json

# Local Claude Code tooling (commands, skills, agents, hooks). Machine-local
# and not project source.
/.claude/agents/
/.claude/commands/
/.claude/hooks/
/.claude/scripts/
/.claude/skills/
# .agents/ is skills-manager scratch and stays ignored, EXCEPT the mastra skill,
# which is kept in-repo so git worktrees (tracked files only) can read it.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/mastra/
/.codex/

# Real-release disk images for opt-in live tests. Never committed.
/corpus/

# Graphify raw scratch output. Regenerable, so it is ignored.
/graphify-out/
