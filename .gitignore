# npm dependencies for the VICE MCP server (src/mcp/vice). Provisioned on
# the consumer side by scripts/ensure-mcp-deps.sh; never committed.
node_modules/

# Host-side VICE supervisor/broker runtime state, written under the resolved
# project root at runtime (see src/mcp/vice/repo-root.ts).
/.vice-supervisor/
/.vice-supervisor.bak-*/

# Host-side RAM snapshots written by the vice_snapshot_save tool, at the path
# snapshotPathFor() builds in src/mcp/vice/stock-paths.ts
# (<repoRoot>/.vice-snapshots/<name>.vsf plus its .json sidecar). This is a
# *product* byproduct, not a project artifact: any consumer of that tool gets
# these files written into their own repo, which is why it is ignored here
# rather than something to clean up once.
/.vice-snapshots/

# Host-side per-run Ghidra project directories, written by ghidra.analyze's
# resolveGhidraProject() at <repoRoot>/tools/ghidra-runs/<runId>
# (src/mcp/vice/ghidra-project.mts, SEAM-04). A *product* byproduct exactly
# like /.vice-snapshots/ above -- any consumer of the ghidra.analyze tool
# gets these written into their own repo. Deliberately written WITHOUT a
# leading slash (still anchored to this directory per git's own middle-slash
# rule) so host-scripts.test.ts's `/tools/` deployed-artifact parity scan --
# which matches on the literal `/tools/` prefix -- does not mistake this
# runtime-scratch entry for a deployed resources/ artifact needing a
# resourceEntries() counterpart; it is not one.
tools/ghidra-runs/

# tools/ is the generated, gitignored deployment target the MCP installer
# copies resources/ into on first tool call (see install-resources.ts). Listed
# per-file (not a blanket /tools/) so host-scripts.test.ts's two-way parity gate
# with resourceEntries() holds; tools/ only ever holds these deployed artifacts.
/tools/backend-detect.mjs
/tools/broker-control.mjs
/tools/broker-epoch.mjs
/tools/broker-kill.mjs
/tools/broker-launch.mjs
/tools/broker-state.mjs
/tools/container-guard.mjs
/tools/ghidra-project.mjs
/tools/host-tool.mjs
/tools/vice-broker.mjs
/tools/vice-launcher.sh
/tools/.vice-deployed.json

# Lockfile stamp written by ensure-mcp-deps.sh when CLAUDE_PLUGIN_DATA is
# unavailable and it falls back to stamping next to the source.
mcp-deps.lock.sha256

# build artifacts from scripts/package.sh
dist/

# Skills copied into the installer package by installer/scripts/sync-skills.mjs
# on `npm pack`/`prepack`. Generated from the canonical src/skills/; never
# committed.
/installer/skills/

# npm pack output
*.tgz

# Synthetic --root fixture trees built by src/mcp/vice/audit-root-args.test.ts.
# They MUST live inside the repository (resolveContainedRoot() refuses anything
# outside it), and they are removed in a `finally` and again in a `t.after`.
# Ignored anyway because a crashed test that left one behind would dirty the
# working tree, and a dirty tree is picked up by every `git status --porcelain`
# assertion in this repository -- so this entry makes a test crash a test
# failure instead of a corruption of the next run.
/.audit-root-synth-*/

# Local editor config, machine-specific, never shared.
/.vscode/

# .claude/settings.json is now COMMITTED (phase 12, GATE-01): it carries only
# the audit-gate PreToolUse hook wiring (scripts/audit-gate.mjs --hook), no
# machine-specific content. The permission allowlist and additionalDirectories
# that used to live in this file -- absolute worktree paths from earlier
# sessions -- moved to .claude/settings.local.json below, which Claude Code
# merges over the committed file at runtime, so behaviour is unchanged. This
# split honours the original rationale (machine-specific permission content
# must not be committed) rather than overriding it; settings.local.json is
# also covered by many users' global gitignore, but this repo-level rule
# makes the guarantee local and explicit rather than relying on that.
/.claude/settings.local.json

# GSD research scratch cache (subagent working files, not artifacts)
.planning/research/.cache/

# GSD runtime lock: a live phase claim, heartbeated per session (4h TTL).
# Runtime state like .gsd/, never an artifact.
/.planning/milestone.lock

# GSD (@opengsd/gsd-core) is a VENDORED install, not project source. It is
# ~700 files / 12MB, regenerated wholesale by `/gsd-update`, and it is stamped
# with THIS machine's absolute paths at install time -- 216 of its 697 files
# contain the literal checkout path, so the tree is not portable to CI, to
# another machine, or to another clone. Committing it would make every
# `/gsd-update` a 12MB diff of unusable-elsewhere content; leaving it merely
# untracked let a stray `git add -A` commit it by accident and kept `git
# status` permanently noisy. Ignoring it explicitly is the intended state:
# GSD may be updated freely and the repo never changes as a result.
#
# Local customisations to this tree are therefore NOT preserved by git. They
# are reapplied idempotently by `node scripts/gsd-reapply-local.mjs` -- run it
# after `/gsd-update`. Nothing in the repo may branch on whether this tree
# exists; guards assert over tracked `.planning/` and `CLAUDE.md` only.
/.claude/gsd-core/
/.claude/gsd-local-patches/
/.claude/gsd-pristine/
/.claude/agents/
/.claude/commands/
/.claude/hooks/
/.claude/scripts/
/.claude/skills/
/.claude/gsd-file-manifest.json
/.claude/gsd-install-state.json
/.claude/gsd-migration-journal/
/.claude/.gsd-profile
/.gsd/
# .agents/ is skills-manager scratch and stays ignored, EXCEPT the mastra skill:
# gsd-planner/executor/researcher read it via agent_skills and run inside git
# worktrees, which only contain TRACKED files. Keeping it in-repo also avoids a
# ~/.claude/skills copy, which would leak into every other GSD project on this
# machine (promolab pins a different mastra revision).
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/mastra/
/.codex/

# Graphify raw scratch output. Regenerable from `/gsd-graphify build`, so it is
# ignored. NOTE: `.planning/graphs/` is deliberately NOT ignored — gsd-planner
# and gsd-phase-researcher read `.planning/graphs/graph.json`, and those agents
# run inside git worktrees, which only contain tracked files.
/graphify-out/

# Phase 35 (DXA-01): the built dxa binary and its intermediate object files.
# vendor/dxa/build.bash's `build` verb reproduces the binary from the
# committed, pinned source on demand -- it is host-architecture-specific and
# a digest gate already defends the committed pin, so committing the binary
# itself would publish an artifact no digest gate could then re-verify.
/src/mcp/vice/vendor/dxa/dxa
/src/mcp/vice/vendor/dxa/*.o

# Phase 36 (OPC-01): the built SLEIGH language file. `ghidra.installExtension`
# / the sleigh-compile-gate.test.ts COMPILE half reproduce it from the
# committed extension source on demand -- mirrors vendor/dxa/dxa above.
/src/mcp/vice/vendor/ghidra-ext/data/languages/6502_nmos.sla

# Phase 36 (OPC-04): a SECOND tools/ghidra-runs/ entry, anchored under
# src/mcp/vice/ specifically. resolveGhidraProject() computes
# <repoRoot>/tools/ghidra-runs/<runId>, and a test (or the compile gate)
# that passes src/mcp/vice as its own repo root would otherwise leave
# untracked run directories there -- the existing tools/ghidra-runs/ entry
# above carries a slash in the middle, so per git's own anchoring rule it
# only matches at the repository root, not at this nested location.
/src/mcp/vice/tools/ghidra-runs/
