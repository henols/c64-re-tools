{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "c64-re-tools",
  "displayName": "C64 Reverse-Engineering Tools",
  "version": "2.0.0",
  "description": "Agent-friendly Commodore 64 engineering toolkit for reverse engineering, debugging, development and testing.",
  "author": {
    "name": "Henrik Olsson",
    "url": "https://github.com/henols"
  },
  "repository": "https://github.com/henols/c64-re-tools",
  "keywords": [
    "c64",
    "commodore-64",
    "vice",
    "6502",
    "6510",
    "acme",
    "reverse-engineering",
    "mcp"
  ],
  "mcpServers": {
    "c64-re-tools": {
      "command": "npx",
      "args": ["-y", "--package=@henols/c64-re-tools@latest", "c64-re-tools-mcp"]
    }
  },
  "defaultEnabled": false
}
