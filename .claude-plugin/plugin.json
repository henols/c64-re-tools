{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "c64-re-tools",
  "displayName": "C64 Reverse-Engineering Tools",
  "version": "0.1.1",
  "description": "VICE emulator MCP server (mcp__plugin_c64-re-tools_vice__* tools) plus C64 reverse-engineering and ACME-rebuild skills.",
  "author": {
    "name": "Henrik Olsson",
    "url": "https://github.com/henols"
  },
  "repository": "https://github.com/henols/c64-re-tools",
  "keywords": [
    "c64",
    "commodore-64",
    "vice",
    "6502",
    "6510",
    "acme",
    "reverse-engineering",
    "mcp"
  ],
  "skills": "./.claude/skills/",
  "mcpServers": "./.mcp.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-mcp-deps.sh\""
          }
        ]
      }
    ]
  },
  "defaultEnabled": false
}
