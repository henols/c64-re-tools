// A dev container for a project that uses c64-re-tools.
// Copy this file to .devcontainer/devcontainer.json in your project.
// The Host Runtime with VICE runs on your computer, outside the container:
//   npx -y --package=@henols/c64-re-tools@latest c64-re-tools-host
// The container reads the options below only when it is built: rebuild it after a change.
{
  "name": "c64",

  // The Feature needs a Debian or Ubuntu image.
  // Ubuntu: "mcr.microsoft.com/devcontainers/base:noble".
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    // The toolkit: Node.js 24, ACME, dxa, Exomizer, c64run, sjasmplus and zxrun. At each start it
    // installs the newest toolkit of its channel into the project, with the tools of that version.
    "https://github.com/henols/c64-re-tools/releases/latest/download/devcontainer-feature-c64-re-tools.tgz": {
      // The harnesses to install the skills and the MCP servers for. One name, or a comma list:
      // claude, codex, pi, opencode, gemini, copilot, cursor, windsurf. Example: "claude,codex".
      "target": "claude",
      // The machines of the project: "c64", "spectrum" or "c64,spectrum".
      "machines": "c64",
      // "latest" for releases. "next" for prereleases: the newer of the prerelease and the release.
      "channel": "latest"
    },

    // The Claude Code CLI. Remove it when you use a different harness.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Lets the container reach the Host Runtime as host.docker.internal with Docker on Linux.
  // Docker Desktop (macOS, Windows) and Podman do not need it; remove it for Podman.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  // Publishes the page of a retro-testing play run (port 6465) on this computer only, at http://localhost:6465/.
  // When 6465 is in use on this computer (two containers), change the first 6465 and open that port.
  "appPort": ["127.0.0.1:6465:6465"],

  "containerEnv": {
    // "pal" or "ntsc": the video standard of the C64.
    "C64RT_VIDEO": "pal",
    // The Host Runtime, when it is not at host.docker.internal or host.containers.internal, port 6464:
    // "C64RT_HOST": "192.168.1.20:6464",
    // A folder for a trace of each run of the MCP server and the skill scripts:
    // "C64RT_TRACE": "/workspaces/c64-trace",
  },

  // Keeps the login and settings of the harness when the container is rebuilt.
  // For a different harness, change the target here and in "config" below, for example /home/vscode/.codex.
  "mounts": ["source=c64-harness-${devcontainerId},target=/home/vscode/.claude,type=volume"],

  "postCreateCommand": {
    // A new volume belongs to root: give it to the user of the container.
    "config": "sudo chown vscode:vscode /home/vscode/.claude",
    // The CLI of a different harness, in place of the Claude Code Feature. Remove // from one line:
    // "cli": "npm install -g @openai/codex",
    // "cli": "npm install -g @mariozechner/pi-coding-agent",
    // "cli": "npm install -g opencode-ai",
    // "cli": "npm install -g @google/gemini-cli",
    // "cli": "npm install -g @github/copilot",
    // Cursor and Windsurf are editors: open the project in the container from the editor.
  },

  "customizations": {
    "vscode": {
      // The Claude Code extension. Use the extension of your harness, or remove the line.
      "extensions": ["anthropic.claude-code"]
    }
  }
}
