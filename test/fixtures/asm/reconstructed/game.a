; The reconstructed source of the end-to-end test's program
; (test/fixtures/prg/basic-counter.ts), with the names that the
; investigation gave it.

counter = $c100                 ; counts to LIMIT
LIMIT   = 10
GREEN   = 5
BORDER  = $d020

        * = $0801
        !word basic_end, 10     ; 10 SYS2061
        !byte $9e, $32, $30, $36, $31, 0
basic_end:
        !word 0

main:
        lda #0
        sta counter
count:
        inc counter
        lda counter
        cmp #LIMIT
        bne count
        lda #GREEN
        sta BORDER
done:
        jmp done
