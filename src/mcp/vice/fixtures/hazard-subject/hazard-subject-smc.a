; hazard-subject-smc.a -- the planted self-modifying-code construction.
;
; WHY AN OPCODE-BYTE PATCH, NOT THE TEXTBOOK OPERAND PATCH
; ---------------------------------------------------------
; The obvious self-modifying idiom -- an `inc`/`dec` that rewrites the
; immediate operand of a nearby `lda #` -- changes a VALUE. A detector that
; only asks "did a store land on an operand byte" catches that shape and
; nothing else. This routine plants the harder case on purpose: a store of a
; literal opcode byte onto another instruction's OPCODE position, so the
; failure mode is a CONTROL-FLOW change rather than a value change. Relocating
; this routine by even one byte moves the address the store targets, and
; nothing in a disassembly listing of either the original or the moved copy
; shows that the two no longer agree -- the listings look identical; only the
; runtime behaviour differs.
;
; THE SHAPE
; ---------
; `hazard_smc_entry` is a short self-terminating loop. On the first pass it
; writes an observable value to the border-colour register (so the effect is
; visible on a real screen and readable back out of memory, not dead code),
; then arms itself by storing the literal byte $60 -- the 6510's `rts` opcode
; -- directly over `smc_patch_target`, which is the OPCODE BYTE of the `nop`
; immediately below this comment. On the second pass through the same loop,
; the CPU no longer executes a `nop` at that address: it executes `rts`, and
; the routine returns exactly where the first pass simply fell through to the
; next instruction. The label `smc_patch_target` is defined as `*` on the line
; immediately before its host instruction, so the address is nameable without
; an absolute literal anywhere in this file.

hazard_smc_entry
smc_patch_target = *
        nop                       ; host instruction: its own opcode byte is
                                   ; overwritten with $60 (rts) below
        lda #$01
        sta $d020                 ; observable: border colour changes on every pass
        lda #$60
        sta smc_patch_target      ; arm: plant the rts opcode over the host
                                   ; instruction's own opcode byte
        jmp hazard_smc_entry

; --- SECOND, DELIBERATELY UNDETECTED SELF-MODIFICATION ----------------------
;
; WHY THIS CONSTRUCTION IS DELIBERATELY BEYOND WHAT A STATIC OPERAND MATCH
; CAN SEE
; ---------------------------------------------------------------------------
; The construction above plants a self-modification a detector reading
; decoded bytes CAN find: the store's target is a literal address encoded
; directly in the instruction. This construction plants the opposite case on
; purpose. The pointer used below is built entirely at runtime, by adding a
; fixed, unrelated bias to a value derived from this file's own labels, and
; the resulting store reaches its target through INDIRECT-INDEXED
; addressing -- the one addressing mode a detector that only inspects literal
; store operands has no address to read at all, because the byte pair that
; actually reaches the target lives in zero page, computed, never spelled out
; as this store instruction's own operand. A report reading this program will
; therefore show a self-modification it did not find. That is recorded here
; as a KNOWN LIMIT rather than left as a silent absence, because a limit a
; reader knows about is worth more than a detector that pretends the case
; does not exist.

; Zero-page pointer this construction builds at runtime. Distinct from the
; raster construction's own zero-page flag in the neighbouring file.
smc2_ptr_lo = $fc
smc2_ptr_hi = $fd

; The bias every runtime computation below adds back. Neither immediate
; operand that follows is the target address or a byte of it: each one is
; the corresponding byte of (the real target address MINUS this bias),
; computed by the assembler from this file's own label, and the real address
; is only ever recovered by adding the bias back at runtime. No instruction
; in this file's assembled bytes ever carries the real target address as an
; operand.
SMC2_BIAS = $0020

; The host instruction: the byte that decides what gets written to the
; border-colour register. `smc2_operand_addr` names the address of its own
; IMMEDIATE OPERAND byte -- one past its opcode -- without ever appearing as
; a literal operand anywhere in this file; every reference to it below goes
; through the biased runtime computation instead.
smc2_operand_addr = * + 1
hazard_smc2_write
        lda #$04
        sta $d020
        rts

hazard_smc2_entry
        ; First pass: the host instruction still carries its original
        ; operand.
        jsr hazard_smc2_write

        ; Build the zero-page pointer. Each immediate below is (the real
        ; operand address MINUS SMC2_BIAS), split into its low and high
        ; byte -- neither one is the operand's real address.
        lda #<(smc2_operand_addr - SMC2_BIAS)
        clc
        adc #<SMC2_BIAS
        sta smc2_ptr_lo
        lda #>(smc2_operand_addr - SMC2_BIAS)
        adc #>SMC2_BIAS
        sta smc2_ptr_hi

        ; The indirect-indexed store: the pointer built above, never a
        ; literal address, names where this byte lands.
        ldy #0
        lda #$05
        sta (smc2_ptr_lo),y

        ; Second pass: the SAME instruction now writes the patched value --
        ; the self-modification actually took effect.
        jsr hazard_smc2_write
        rts
