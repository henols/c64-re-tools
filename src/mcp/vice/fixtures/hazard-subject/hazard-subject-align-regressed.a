; hazard-subject-align-regressed.a -- the regressed twin of
; hazard-subject-align.a, carrying two planted single-bit regressions.
;
; THIS FILE DIFFERS FROM hazard-subject-align.a IN EXACTLY TWO PLACES.
;
; FIRST: the sprite-enable immediate that feeds `sta $d015` is changed from
; `lda #%00000001` to `lda #%00000000`. %00000001 XOR %00000000 = $01, a
; single bit.
;
; SECOND: the immediate that feeds `sta $d018` is changed from the
; committed derivation to `align_regressed_char_select`, a named constant
; defined below. Its value is the committed derivation with the
; character-set select field (bits #1-#3, `align_char_base / 2048`) moved
; by one 2048-byte block -- `+1`, not written as a bare literal, so the
; regression is still visibly derived from the same labels the committed
; file derives from. On this fixture's own committed layout the field's
; current value (`align_char_base / 2048` = 2) is even, so incrementing it
; by one flips only the field's own low bit with no carry into the
; adjacent screen-offset field -- the emitted byte therefore differs from
; the committed one by exactly bit #1 ($02), a single bit.
;
; Nothing else in this file is touched: no instruction is added, removed
; or resized, and the routine's other three stores ($dd00, $d011, $07f8),
; both `!align` directives and all four data tables are copied unchanged
; from hazard-subject-align.a.
;
; WHY THIS FILE EXISTS: it is a RED CONTROL for the cross-binary comparison
; instrument (compare-cross-binary.mjs, plan 50-01), the same role
; hazard-subject-dispatch-regressed.a plays for $D020. Under the narrowed
; mask this phase committed first, $D015 and $D018 stay deliberately
; visible to the verdict, so these two planted single-bit regressions must
; make the comparison FAIL. This file is never assembled on its own -- it
; is pulled into a synthesized root by make-hazard-subject-fixtures.mjs's
; third FIXTURES entry, in place of hazard-subject-align.a.

align_screen_offset = $0400

; The regressed $d018 value: the committed derivation's character-set
; select field moved one 2048-byte block forward. Forward-references
; align_char_base the same way the committed derivation does -- ACME's own
; multi-pass assembly resolves it.
align_regressed_char_select = ((align_screen_offset / 1024) << 4) | (((align_char_base / 2048) + 1) << 1)

hazard_align_entry
        ; Select VIC bank 0 ($0000-$3fff) through a single immediate load
        ; followed directly by its store -- not the read-modify-write this
        ; routine used to carry. A read-modify-write's result depends on
        ; whatever the CIA2 port A register already held at runtime, which
        ; is a runtime fact a static report cannot recover: it is exactly
        ; the shape `recoverImmediateStoreFacts()` in `anno-hazard-report.ts`
        ; correctly declines to treat as known, so a subject that depends on
        ; this register's value and never states it statically is asking a
        ; static report to guess. $3f mirrors the value
        ; `fixtures/ghidra/charset-phantom.a` already uses for the same
        ; purpose: bits #0-#1 = %11 select VIC bank 0 (active low). THE
        ; COST: this bare store also drives the CIA2 port A bits the old
        ; read-modify-write preserved -- the serial-bus lines (ATN/CLK/DATA)
        ; among them -- to $3f's own fixed state (all of bits #2-#7 set)
        ; rather than leaving them at whatever this program's own earlier
        ; serial-bus activity had set them to. That preservation is given up
        ; here so the bank select is statically recoverable.
        lda #$3f
        sta $dd00

        ; REGRESSED: the VIC memory-control register, computed from
        ; align_regressed_char_select instead of the committed inline
        ; derivation -- see the header above for the exact bit that moves.
        lda #align_regressed_char_select
        sta $d018

        ; VIC-II control register 1: name character (text) mode explicitly,
        ; bit 5 clear, through the same immediate-load-then-store shape as
        ; the bank select above. This register was never written at all
        ; before this edit, which is the second reason the page-alignment
        ; dependency below could not be recovered statically: a static
        ; report can only tell character mode from bitmap mode if the
        ; program itself states which one it is using. $1b mirrors the same
        ; model fixture's own control-register-1 value (extended-colour and
        ; bitmap bits both clear, screen enabled).
        lda #$1b
        sta $d011

        ; Sprite pointer: the sprite base divided by 64, computed from the
        ; label rather than written as a literal.
        lda #(align_sprite_base / 64)
        sta $07f8

        ; REGRESSED: sprite enable, changed from %00000001 to %00000000 --
        ; see the header above. The position writes below are copied
        ; unchanged; a disabled sprite has no visible position, but the
        ; bytes themselves are still emitted identically.
        lda #%00000000
        sta $d015
        lda #100
        sta $d000
        lda #100
        sta $d001

        ; Print one character from the custom character set: screen code 0
        ; addresses char_base's own first (and only committed) glyph.
        lda #0
        sta align_screen_offset
        rts

; --- Character set, 2K-ALIGNED within the current VIC bank. A real
; character set occupies a full 2048-byte block, one glyph per 8 bytes; this
; fixture commits one recognisable glyph at the boundary and states that
; shortfall here rather than silently implying a full set exists.
!align $7ff, 0
align_char_base
        !byte %01111110
        !byte %11111111
        !byte %11100111
        !byte %11100111
        !byte %11111111
        !byte %11111111
        !byte %01111110
        !byte %00000000

; --- Sprite shape, 64-BYTE-ALIGNED within the current VIC bank. A real
; sprite occupies all 63 data bytes; this fixture fills every one of them so
; the shape is a real, solid block rather than a stub.
!align $3f, 0
align_sprite_base
        !fill 63, %11111111

; --- Level table: a plain labelled byte table, no alignment constraint. It
; exists so the multi-file export path has a real, ordinary data range to
; extract that is not itself hazard-bearing.
align_level_table
        !byte 1, 2, 3, 4, 5, 6, 7, 8

; --- Music table: the same role as the level table, with distinct,
; recognisable content.
align_music_table
        !byte $c0, $90, $60, $40, $30, $20, $10, $08
