{
  "name": "@henols/vice-mcp",
  "version": "0.0.0-dev",
  "description": "VICE emulator MCP server for C64 reverse-engineering: a stdio MCP server that proxies vice tools to a host VICE MCP server.",
  "type": "module",
  "bin": {
    "vice-mcp": "vice-cli.mjs"
  },
  "main": "vice-cli.mjs",
  "files": [
    "vice-cli.mjs",
    "anno-regbits.json",
    "prerequisites.json",
    "dist/",
    "resources",
    "tools-manifest.stock.json",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "vendor/ghidra-ext/",
    "vendor/ghidra-scripts/",
    "vendor/dxa/",
    "!vendor/dxa/dxa"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "Henrik Olsson",
    "url": "https://github.com/henols"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henols/c64-re-tools.git",
    "directory": "src/mcp/vice"
  },
  "homepage": "https://github.com/henols/c64-re-tools#readme",
  "bugs": {
    "url": "https://github.com/henols/c64-re-tools/issues"
  },
  "keywords": [
    "c64",
    "commodore-64",
    "vice",
    "6502",
    "6510",
    "mcp",
    "reverse-engineering"
  ],
  "scripts": {
    "test": "node --test '*.test.*'",
    "test:automated": "node test-gate.ts",
    "test:manual": "node test-gate.ts --manual",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.ts",
    "generate:readme": "node prereq-readme-gen.ts --write",
    "smoke": "node smoke.ts",
    "prepack": "node build.ts --server"
  },
  "dependencies": {
    "@mastra/mcp": "1.15.0",
    "@mastra/core": "1.55.0",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
