{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": false,
    "declaration": false,
    "allowJs": false,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "../../../skills/*/scripts/*.ts",
    "../../../test/**/*.ts",
    "../../../test/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "resources"
  ]
}
